{"componentChunkName":"component---src-templates-product-tsx","path":"/sklo/reflect-pendant/","result":{"data":{"directus":{"product":{"id":"3909","title":"Reflect","slug":"reflect-pendant","href":"https://www.sklo.com/product/reflect/","description":"Reflect Pendants are a series of mirror-plated glass pendants in different geometric shapes suspended on rigid brass stems. The glass is mirrored using a unique process that produces an opaque mirror appearance when the light is off but allows light to pass through when on. Each shape has an open mouth at the bottom, the hole ground, and polished. The glass sits on a rest at the end of the stem and lifts to expose the socket for changing the bulb. Available in three different shapes. Glass available in silver mirror finish only.","designer":"Sklo","collection":null,"subtitle":null,"image_primary":{"id":"67d88414-8a82-4dc9-af8f-1919a32d6f34","imageFile":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","backgroundColor":"#c8c8c8","images":{"fallback":{"src":"/static/833415dbebe76943af7d1b9b2d9aec10/ea7d4/SkLO_Reflect_ENV_2_1080.jpg","srcSet":"/static/833415dbebe76943af7d1b9b2d9aec10/a4a7a/SkLO_Reflect_ENV_2_1080.jpg 207w,\n/static/833415dbebe76943af7d1b9b2d9aec10/b244b/SkLO_Reflect_ENV_2_1080.jpg 414w,\n/static/833415dbebe76943af7d1b9b2d9aec10/ea7d4/SkLO_Reflect_ENV_2_1080.jpg 828w","sizes":"(min-width: 828px) 828px, 100vw"},"sources":[{"srcSet":"/static/833415dbebe76943af7d1b9b2d9aec10/377e9/SkLO_Reflect_ENV_2_1080.webp 207w,\n/static/833415dbebe76943af7d1b9b2d9aec10/8cdb9/SkLO_Reflect_ENV_2_1080.webp 414w,\n/static/833415dbebe76943af7d1b9b2d9aec10/8fe2e/SkLO_Reflect_ENV_2_1080.webp 828w","type":"image/webp","sizes":"(min-width: 828px) 828px, 100vw"}]},"width":1200,"height":1739.1304347826087}}}},"image_secondary":null,"tags":["Lighting","Pendant"],"manufacturer":{"title":"Sklo","slug":"sklo","image_logo_dark":{"id":"5d53f734-21d0-4521-9b01-fe059eec450d","imageFile":{"publicURL":"/static/16f1340a3d22c93fed1